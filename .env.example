# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/railblock
DB_HOST=localhost
DB_PORT=5433
DB_NAME=railblock
DB_USER=postgres
DB_PASSWORD=postgres

# ── Backend ───────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
SECRET_KEY=change-me-in-production

# ── CORS ──────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── pgAdmin (optional) ───────────────────────────────
PGADMIN_EMAIL=admin@railblock.dev
PGADMIN_PASSWORD=admin
